# H20 CT diagnostic: H12 + bounded NVFP4 MoE conversion fingerprints.
FROM vllm-orcarouter-v029-h12-ct-postload-preserve:v1

ARG SP=/usr/local/lib/python3.12/dist-packages
ARG CT=${SP}/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_w4a4_nvfp4.py
ARG Q4=${SP}/vllm/models/qwen4_exp/nvidia/model.py

COPY patch-v029-nvfp4-moe-convert-diagnostics.py /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py
COPY patch-v029-h20c-runtime-moe-trace.py /tmp/patch-v029-h20c-runtime-moe-trace.py
COPY patch-v029-h20-upstream-layer0.py /tmp/patch-v029-h20-upstream-layer0.py
RUN cp ${CT} ${CT}.h20.orig \
 && python3 /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py ${CT} ct \
 && python3 /tmp/patch-v029-h20c-runtime-moe-trace.py ${CT} ct \
 && python3 /tmp/patch-v029-h20-upstream-layer0.py ${Q4} \
 && rm /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py /tmp/patch-v029-h20c-runtime-moe-trace.py /tmp/patch-v029-h20-upstream-layer0.py \
 && python3 - <<'PY'
import ast
p="/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_w4a4_nvfp4.py"
s=open(p, encoding="utf-8").read()
ast.parse(s)
body=s[s.index("class CompressedTensorsW4A4Nvfp4MoEMethod"):]
assert 'source="ct"' in body
assert 'phase="pre"' in body
assert 'phase="post"' in body
assert 'phase="quant_config"' in body
assert 'phase="kernel_created"' in body
assert 'phase="fused_postload"' in body
assert "h20_w13_scale_2 = 1.0 / w13_weight_global_scale" in body
assert "QWEN38_H20_MOE_DIAG " in s
assert "QWEN38_H20C_RUNTIME " in s
assert "QWEN38_H20D_TWIN " in s
assert "QWEN38_H20D_SINGLE " in s
assert "_qwen38_h20d_single_request_id" in s
assert "_qwen38_h20d_request_id" in s
assert "h20d_output2 = self.moe_kernel.apply(" in body
assert "h20d_x_ref = x.clone()" in body
assert "h20d_x_run2 = x.clone()" in body
q4="/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/model.py"
q4s=open(q4, encoding="utf-8").read()
ast.parse(q4s)
assert "QWEN38_H20U_LAYER0 " in q4s
assert '@torch.library.custom_op(' in q4s
assert '"qwen38_h20u::capture"' in q4s
assert 'mutates_args={"tensor"}' in q4s
assert "_qwen38_h20u_capture(hidden_states, 0, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(block_input, 1, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(attn_out, 2, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(block_input, 3, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(mlp_out, 4, self.layer_idx)" in q4s
assert "@torch.compiler.disable" not in q4s
import torch
from vllm.models.qwen4_exp.nvidia.model import _qwen38_h20u_capture

@torch.compile(fullgraph=True, backend="eager")
def h20u_fullgraph_smoke(x):
    _qwen38_h20u_capture(x, 0, 0)
    return x + 1

h20u_smoke_in = torch.tensor([1.0])
h20u_smoke_out = h20u_fullgraph_smoke(h20u_smoke_in)
assert h20u_smoke_out.item() == 2.0
assert '_QWEN38_H20C_SOURCE = "ct"' in s
assert "output = self.moe_kernel.apply(" in body
print("H20 CT NVFP4 conversion diagnostics installed")
PY

LABEL qwen38.h20="ct-nvfp4-convert-diag-v9"
