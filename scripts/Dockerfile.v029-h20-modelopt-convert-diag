# H20 ModelOpt diagnostic: base v0.29 + bounded NVFP4 MoE conversion fingerprints.
FROM vllm-orcarouter-v029:v1

ARG SP=/usr/local/lib/python3.12/dist-packages
ARG MO=${SP}/vllm/model_executor/layers/quantization/modelopt.py
ARG Q4=${SP}/vllm/models/qwen4_exp/nvidia/model.py
ARG GDN=${SP}/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py

COPY patch-v029-nvfp4-moe-convert-diagnostics.py /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py
COPY patch-v029-h20c-runtime-moe-trace.py /tmp/patch-v029-h20c-runtime-moe-trace.py
COPY patch-v029-h20-upstream-layer0.py /tmp/patch-v029-h20-upstream-layer0.py
COPY patch-v029-h20-linear-attn-layer0.py /tmp/patch-v029-h20-linear-attn-layer0.py
RUN cp ${MO} ${MO}.h20.orig \
 && python3 /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py ${MO} modelopt \
 && python3 /tmp/patch-v029-h20c-runtime-moe-trace.py ${MO} modelopt \
 && python3 /tmp/patch-v029-h20-upstream-layer0.py ${Q4} \
 && python3 /tmp/patch-v029-h20-linear-attn-layer0.py ${GDN} \
 && rm /tmp/patch-v029-nvfp4-moe-convert-diagnostics.py /tmp/patch-v029-h20c-runtime-moe-trace.py /tmp/patch-v029-h20-upstream-layer0.py /tmp/patch-v029-h20-linear-attn-layer0.py \
 && python3 - <<'PY'
import ast
p="/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/modelopt.py"
s=open(p, encoding="utf-8").read()
ast.parse(s)
body=s[s.index("class ModelOptNvFp4FusedMoE"):]
assert 'source="modelopt"' in body
assert 'phase="pre"' in body
assert 'phase="post"' in body
assert 'phase="quant_config"' in body
assert 'phase="kernel_created"' in body
assert 'phase="fused_postload"' in body
assert "QWEN38_H20_MOE_DIAG " in s
assert "QWEN38_H20C_RUNTIME " in s
assert "QWEN38_H20D_TWIN " in s
assert "QWEN38_H20D_SINGLE " in s
assert "_qwen38_h20d_single_request_id" in s
assert "_qwen38_h20d_request_id" in s
assert "h20d_output2 = self.moe_kernel.apply(" in body
assert "h20d_x_ref = x.clone()" in body
assert "h20d_x_run2 = x.clone()" in body
q4="/usr/local/lib/python3.12/dist-packages/vllm/models/qwen4_exp/nvidia/model.py"
q4s=open(q4, encoding="utf-8").read()
ast.parse(q4s)
assert "QWEN38_H20U_LAYER0 " in q4s
assert '@torch.library.custom_op(' in q4s
assert '"qwen38_h20u::capture"' in q4s
assert 'mutates_args={"tensor"}' in q4s
assert "_qwen38_h20u_capture(hidden_states, 0, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(block_input, 1, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(attn_out, 2, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(block_input, 3, self.layer_idx)" in q4s
assert "_qwen38_h20u_capture(mlp_out, 4, self.layer_idx)" in q4s
assert "\n@torch.compiler.disable\n" not in q4s
import torch
from vllm.models.qwen4_exp.nvidia.model import _qwen38_h20u_capture

@torch.compile(fullgraph=True, backend="eager")
def h20u_fullgraph_smoke(x):
    _qwen38_h20u_capture(x, 0, 0)
    return x + 1

h20u_smoke_in = torch.tensor([1.0])
h20u_smoke_out = h20u_fullgraph_smoke(h20u_smoke_in)
assert h20u_smoke_out.item() == 2.0
gdn="/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py"
gdns=open(gdn, encoding="utf-8").read()
ast.parse(gdns)
assert "QWEN38_H20L_LINEAR " in gdns
assert '"qwen38_h20l::capture"' in gdns
assert "_qwen38_h20l_capture(mixed_qkvz, 1" in gdns
assert "_qwen38_h20l_capture(ba, 2" in gdns
assert "_qwen38_h20l_capture(core_attn_out, 7" in gdns
assert "_qwen38_h20l_capture(output, 8" in gdns
from vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn import _qwen38_h20l_capture

@torch.compile(fullgraph=True, backend="eager")
def h20l_fullgraph_smoke(x):
    _qwen38_h20l_capture(x, 0, 0)
    return x + 1

h20l_smoke_in = torch.tensor([1.0])
h20l_smoke_out = h20l_fullgraph_smoke(h20l_smoke_in)
assert h20l_smoke_out.item() == 2.0
assert '_QWEN38_H20C_SOURCE = "modelopt"' in s
assert "output = self.moe_kernel.apply(" in body
print("H20 ModelOpt NVFP4 conversion diagnostics installed")
PY

LABEL qwen38.h20="modelopt-nvfp4-convert-diag-v10"
