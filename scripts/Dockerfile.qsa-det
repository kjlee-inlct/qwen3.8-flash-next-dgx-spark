# OrcaRouter experimental image: existing GB10/TP=1 skinny-GEMM image + deterministic QSA top-k.
#
# Build:
#   docker build -t vllm-skinny-qsa-det:v1 -f scripts/Dockerfile.qsa-det scripts/
#
# This deliberately adds only the deterministic persistent_topk kernel and qsa.py wiring.
# It does not include the unrelated hybrid, KV, prefix-cache, MTP-vocab, or NVIDIA mixed
# precision patches from other DGX Spark recipes.
FROM vllm-skinny-tp1:v1

ARG SP=/usr/local/lib/python3.12/dist-packages
ARG KDET_SHA=e0ef69d4f5575dad00d34e05479eaf4c6547bace
ARG KDET=https://raw.githubusercontent.com/jschmied/qwen38-flash-next-gb10/${KDET_SHA}
ARG DET_ARCH=121a

# Pinned by both commit and sha256. Sources are Apache-2.0 upstream artifacts used by
# the deterministic persistent_topk implementation associated with vLLM PR #55122.
ADD --checksum=sha256:138cacfc5eb117f0922d53c88727e4d0dc26dcfb246c3d401fc280cfc726cc71 \
    ${KDET}/patches/kernel-det/build_det.py /opt/qwen38/kernel-det/src/build_det.py
ADD --checksum=sha256:b103fbeaf7589b9468471142ad0b30012a076f93d20ba11fc5ff6dcb1ecd32a6 \
    ${KDET}/patches/kernel-det/bindings_det.cpp /opt/qwen38/kernel-det/src/bindings_det.cpp
ADD --checksum=sha256:19e1d53425ea9a839445722fd1dac1c41727128eebdce84508c1bfb8592afecf \
    ${KDET}/patches/kernel-det/topk_det.cu /opt/qwen38/kernel-det/src/topk_det.cu
ADD --checksum=sha256:16939700ae389750782ff5c0d5b9caef59aa0ff8b869b64ec94fa72c814910ee \
    ${KDET}/patches/kernel-det/torch_utils.h /opt/qwen38/kernel-det/src/torch_utils.h
ADD --checksum=sha256:b4ef9ce298d43d6c0e6db9fcca451df20815b2cfe33791919c1ad9c0e84f0ba7 \
    ${KDET}/patches/kernel-det/persistent_topk.cuh /opt/qwen38/kernel-det/src/persistent_topk.cuh
ADD --checksum=sha256:70905073fe3fa361030bf1cb469b74610766bdfe361419cd7df50af2561322e3 \
    ${KDET}/tools/determinism/qsadet_patch.py /tmp/qsadet_patch.py

RUN cd /opt/qwen38/kernel-det/src \
 && DET_BUILD_DIR=/opt/qwen38/kernel-det/build DET_ARCH=${DET_ARCH} python3 build_det.py \
 && cp /opt/qwen38/kernel-det/build/_C_det.so /opt/qwen38/kernel-det/_C_det.so \
 && VLLM_QSA_PY=${SP}/vllm/models/qwen3_8_flash_next/nvidia/ops/qsa.py python3 /tmp/qsadet_patch.py \
 && rm /tmp/qsadet_patch.py \
 && python3 - <<'PY'
import ast
p="/usr/local/lib/python3.12/dist-packages/vllm/models/qwen3_8_flash_next/nvidia/ops/qsa.py"
s=open(p, encoding="utf-8").read()
ast.parse(s)
assert "VLLM_QSA_DET_TOPK" in s
assert "VLLM_QSA_DET_LIB" in s
print("deterministic QSA top-k wired")
PY
