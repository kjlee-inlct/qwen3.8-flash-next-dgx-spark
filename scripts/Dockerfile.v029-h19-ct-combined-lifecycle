# H19 control: H12 + H17 weight_scale_2 lifecycle + H18 input_scale lifecycle.
# Apply the already-tested H17 and H18 patches sequentially to the H12 parent.
FROM vllm-orcarouter-v029-h12-ct-postload-preserve:v1

ARG SP=/usr/local/lib/python3.12/dist-packages
ARG CT=${SP}/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_w4a4_nvfp4.py

COPY patch-v029-ct-moe-postload-weight-scale2-lifecycle.py /tmp/patch-v029-ct-moe-postload-weight-scale2-lifecycle.py
COPY patch-v029-ct-moe-postload-input-scale-lifecycle.py /tmp/patch-v029-ct-moe-postload-input-scale-lifecycle.py
RUN cp ${CT} ${CT}.h19.orig \
 && python3 /tmp/patch-v029-ct-moe-postload-weight-scale2-lifecycle.py ${CT} \
 && python3 /tmp/patch-v029-ct-moe-postload-input-scale-lifecycle.py ${CT} \
 && rm /tmp/patch-v029-ct-moe-postload-weight-scale2-lifecycle.py \
       /tmp/patch-v029-ct-moe-postload-input-scale-lifecycle.py \
 && python3 - <<'PY'
import ast
p="/usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors_moe/compressed_tensors_moe_w4a4_nvfp4.py"
s=open(p, encoding="utf-8").read()
ast.parse(s)
start=s.index("class CompressedTensorsW4A4Nvfp4MoEMethod")
body=s[start:]

# H17 lifecycle
assert 'layer.register_parameter("w13_weight_scale_2", w13_weight_scale_2_param)' in body
assert 'layer.register_parameter("w2_weight_scale_2", w2_weight_scale_2_param)' in body
assert 'delattr(layer, "w13_weight_global_scale")' in body
assert 'delattr(layer, "w2_weight_global_scale")' in body
assert "w13_scale_2=(1.0 / w13_weight_scale_2)" in body
assert "w2_scale_2=(1.0 / layer.w2_weight_scale_2)" in body

# H18 lifecycle
assert 'layer.register_parameter("w13_input_scale", w13_input_scale_param)' in body
assert 'layer.register_parameter("w2_input_scale", w2_input_scale_param)' in body
assert 'delattr(layer, "w13_input_global_scale")' in body
assert 'delattr(layer, "w2_input_global_scale")' in body
assert "a13_scale=(1.0 / layer.w13_input_scale)" in body
assert "a2_scale=(1.0 / layer.w2_input_scale)" in body

# Final converted tensors replace existing final-name parameters.
assert 'replace_parameter(layer, "w13_weight_scale_2", w13_scale_2)' in body
assert 'replace_parameter(layer, "w2_weight_scale_2", w2_scale_2)' in body
assert 'replace_parameter(layer, "w13_input_scale", a13_scale)' in body
assert 'replace_parameter(layer, "w2_input_scale", a2_scale)' in body

print("H19 combined CT post-load lifecycle patches installed")
PY

LABEL qwen38.h19="compressed-tensors-postload-combined-lifecycle-v1"
